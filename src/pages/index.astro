---
import "../styles/styles.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Head Soccer</title>
    <meta
      name="description"
      content="Head Soccer: two heads, one ball, ninety seconds. A small browser game for COMP4020."
    />
    <meta name="theme-color" content="#0d1b2a" />

    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="hud">
      <h1>Head Soccer</h1>
      <p class="score" id="score" aria-live="off">0 – 0</p>
      <div class="meta">
        <p class="clock" id="clock">1:30</p>
        <nav aria-label="Primary">
          <a
            href="https://github.com/comp4020-agentic-coding-studio/comp4020-crit5-tawhidlabib"
            >Source</a
          >
        </nav>
      </div>
    </header>

    <main>
      <canvas id="pitch">Head Soccer</canvas>
    </main>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
